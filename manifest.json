{
  "manifest_version": 3,
  "name": "Pesky Ads Blocker",
  "version": "1.0.0",
  "description": "Removes hidden click-hijacking overlays that redirect you to ad sites instead of letting you use the page.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pesky Ads Blocker"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["content.js"]
    }
  ]
}
